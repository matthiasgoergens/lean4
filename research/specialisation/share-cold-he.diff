+/-- `heapSortM` at `Id`, compiled once. -/
+@[noinline] def heapSortId (lt : α → α → Id (ULift.{u} Bool)) (xs : Vector α n) (a b : Nat)
+    (hab : a ≤ b) (hb : b ≤ n) : Id (Vector α n) :=
